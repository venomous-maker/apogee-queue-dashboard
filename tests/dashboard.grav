// apogee-queue-dashboard's tests: jobs run by a real worker are recorded
// (processed, failed, run and wait times, tags, batches, workers, queues) the
// same way by the memory, Redis and database (SQLite) stores; the page and its
// JSON API answer through apogee-testing's client: job detail, tag search and
// monitored tags, failed jobs retried and forgotten, batches, pausing workers;
// alerts on long waits; silenced jobs; and the gate. The Redis store's test
// needs a server (REDIS_URL, default redis://127.0.0.1:6379/9).
import "std"
import "apogee-container"
import "apogee-events"
import "apogee-http"
import "apogee-routing"
import "apogee-queue"
import "apogee-testing"
import "grav-redis"
import "grav-db"
import "../src/all.grav"
use apogee.*
use redis.*
use db.*

class SendInvoice extends Job {
    public n: int = 0
    constructor(n: int = 0) { self.n = n }
    fn tags() -> Array<string> { return ["invoice:" + str(self.n), "billing"] }
    fn handle() { Time.sleepMs(2) }
}
class Explodes extends Job {
    constructor() { self.tries = 1 }
    fn handle() { throw new StateError("the printer is on fire") }
}
class Heartbeat extends Job {
    constructor() {}
    fn handle() {}
}

fn setup(store: DashboardStore) -> QueueDashboard {
    let c = new Container()
    let q = new QueueManager(c)
    q.addConnection("memory", new MemoryQueueDriver())
    q.defaultConnection = "memory"
    let d = new QueueDashboard(q, store)
    d.silence("Heartbeat")
    d.attach(new Events(c))
    return d
}

fn work(d: QueueDashboard, queues: Array<string>) {
    let o = new WorkerOptions()
    o.sleep = 0.05
    o.memoryMb = 0
    o.stopWhenEmpty = true
    o.name = "worker-1"
    d.queue.worker().work("memory", queues, o)
}

fn run(d: QueueDashboard) {
    d.store.monitor("billing")
    for (i in 0..3) { d.queue.dispatch(new SendInvoice(i)) }
    d.queue.dispatch(new Explodes())
    d.queue.dispatch(new SendInvoice(9).onQueue("mail"))
    d.queue.dispatch(new Heartbeat())
    d.queue.batch([new SendInvoice(20), new SendInvoice(21)] as Array<Job>).name("month end").dispatch()
    Time.sleepMs(20)                                    // (so the waits are not all zero)
    work(d, ["default", "mail"])
}

fn checks(d: QueueDashboard) {
    let s = d.stats()
    assertEq(s.get("processedLastHour").asInt(), 7)     // 3 + 1 + heartbeat + 2 in the batch
    assertEq(s.get("failedLastHour").asInt(), 1)
    assertEq(s.get("failedTotal").asInt(), 1)
    assertEq(s.get("status").asString(), "inactive")
    assertEq(s.get("workers").at(0).get("name").asString(), "worker-1")
    let queues = s.get("queues")
    assertEq(queues.size(), 2)
    let q0 = queues.at(0)
    assertEq(q0.get("queue").asString(), "default")
    assertEq(q0.get("waiting").asInt(), 0)
    assertEq(q0.get("processed").asInt(), 6)
    assert(q0.get("averageWaitMs").asInt() >= 15)
    assert(q0.get("averageRunMs").asInt() >= 1)
    let metrics = d.jobMetrics()
    assertEq(metrics.size(), 3)
    assertEq(metrics.at(0).get("job").asString(), "Explodes")
    assertEq(metrics.at(0).get("failed").asInt(), 1)
    assertEq(metrics.at(2).get("job").asString(), "SendInvoice")
    assertEq(metrics.at(2).get("processed").asInt(), 6)
    // the heartbeat is counted, but silenced in the list
    let recent = d.recentJobs(20)
    assertEq(recent.size(), 7)
    for (r in recent.asArray()) { assert(r.get("job").asString() != "Heartbeat") }
    assertEq(d.recentJobs(20, "failed").size(), 1)
    assert(Str.contains(d.recentJobs(20, "failed").at(0).get("error").asString(), "the printer is on fire"))
    // tags: searched in the recent jobs, kept for a monitored one
    assertEq(d.jobsWithTag("invoice:9").size(), 1)
    assertEq(d.jobsWithTag("billing").size(), 6)
    assertEq(d.tags().at(0).get("jobs").asInt(), 6)
    // detail, with the payload
    let one = d.jobsWithTag("invoice:2").at(0)
    let detail = d.jobDetail(one.get("id").asString())
    assert(Str.contains(detail.get("payloadPretty").asString(), "\"n\": 2"))
    assert(detail.get("waitMs").asInt() >= 15)
    // batches
    let b = d.batches()
    assertEq(b.size(), 1)
    assertEq(b.at(0).get("name").asString(), "month end")
    assertEq(b.at(0).get("progress").asInt(), 100)
    let minutes = d.throughput(5)
    assertEq(minutes.at(4).get("processed").asInt() + minutes.at(3).get("processed").asInt(), 7)
}

fn app(d: QueueDashboard) -> HttpKernel {
    let r = new Router(new Container())
    d.routes(r, "queue-dashboard")
    return new HttpKernel(r)
}

test "the memory store" {
    let d = setup(new MemoryDashboardStore())
    run(d)
    checks(d)
}

test "the database store (SQLite)" {
    let file = Dir.temp() + "/qd_test_" + str(Process.pid()) + ".sqlite"
    new File(file).delete()
    let pool = new Pool(4, fn() -> Connection { return Sqlite.open(file) })
    let store = new DatabaseDashboardStore(pool)
    store.createTables()
    store.createTables()                                // (again: nothing happens)
    let d = setup(store)
    run(d)
    checks(d)
    store.clear()
    assertEq(store.recentJobs(10).size(), 0)
    new File(file).delete()
}

test "the Redis store, shared between connections" {
    let url = env("REDIS_URL") == "" ? "redis://127.0.0.1:6379/9" : env("REDIS_URL")
    let store = new RedisDashboardStore(RedisConnection.open(url), "qd-test-" + str(Process.pid()) + ":")
    store.clear()
    let d = setup(store)
    run(d)
    checks(d)
    let other = new RedisDashboardStore(RedisConnection.open(url), store.prefix)
    assertEq(other.recentJobs(10).size(), 7)
    assertEq(other.jobMetrics().size(), 3)
    store.clear()
    assertEq(other.recentJobs(10).size(), 0)
}

test "the page and its JSON API" {
    let d = setup(new MemoryDashboardStore())
    run(d)
    let c = new TestClient(app(d))
    c.get("/queue-dashboard").assertOk().assertSee("<title>Queue dashboard</title>").assertSee("const base = \"/queue-dashboard\"")
    c.getJson("/queue-dashboard/api/stats").assertOk().assertJsonPath("processedLastHour", 7).assertJsonPath("paused", false)
    c.getJson("/queue-dashboard/api/metrics/queues").assertJsonCount(2).assertJsonPath("0.queue", "default")
    c.getJson("/queue-dashboard/api/jobs/tagged/invoice%3A9").assertJsonCount(1).assertJsonPath("0.job", "SendInvoice")
    let rec = c.getJson("/queue-dashboard/api/jobs/recent?limit=3").assertJsonCount(3)
    c.getJson("/queue-dashboard/api/jobs/" + rec.jsonAt("0.id").asString()).assertOk().assertJsonPath("job", "SendInvoice")
    c.getJson("/queue-dashboard/api/jobs/no-such-job").assertNotFound()
    c.getJson("/queue-dashboard/api/batches").assertJsonCount(1).assertJsonPath("0.total", 2)
    c.postJson("/queue-dashboard/api/tags", {"tag": "invoice:1"}).assertOk()
    c.getJson("/queue-dashboard/api/tags").assertJsonCount(2)
    c.deleteJson("/queue-dashboard/api/tags/invoice%3A1").assertOk()
    c.getJson("/queue-dashboard/api/tags").assertJsonCount(1)
    // failed jobs
    let failed = c.getJson("/queue-dashboard/api/jobs/failed").assertJsonCount(1).assertJsonPath("0.job", "Explodes")
    let id = failed.jsonAt("0.id").asString()
    c.getJson("/queue-dashboard/api/jobs/failed/" + id).assertOk()
    c.postJson("/queue-dashboard/api/jobs/failed/" + id + "/retry", null).assertOk().assertJsonPath("retried", true)
    assertEq(d.queue.size("default"), 1)
    c.getJson("/queue-dashboard/api/jobs/failed").assertJsonCount(0)
    work(d, ["default"])
    let again = c.getJson("/queue-dashboard/api/jobs/failed").assertJsonCount(1)
    c.deleteJson("/queue-dashboard/api/jobs/failed/" + again.jsonAt("0.id").asString()).assertOk()
    c.deleteJson("/queue-dashboard/api/jobs/failed/nope").assertNotFound()
    // pausing workers
    c.postJson("/queue-dashboard/api/workers/pause", null).assertOk()
    c.getJson("/queue-dashboard/api/stats").assertJsonPath("status", "paused")
    assert(Worker.isPausedIn(d.queue.cache))
    c.postJson("/queue-dashboard/api/workers/continue", null).assertOk()
    c.getJson("/queue-dashboard/api/stats").assertJsonPath("paused", false)
}

test "an alert when a queue's wait grows too long" {
    let d = setup(new MemoryDashboardStore())
    run(d)                                              // (gives the queue an average run time)
    let alerts = new Array<LongWait>()
    d.alertWhenWaitExceeds(1, fn(w: LongWait) { alerts.push(w) })
    for (i in 0..2000) { d.queue.dispatch(new SendInvoice(i)) }
    let sent = d.checkWaits()
    assertEq(sent.size(), 1)
    assertEq(alerts[0].queue, "default")
    assert(alerts[0].seconds >= 1)
    assertEq(d.checkWaits().size(), 0)                  // not again within five minutes
}

test "only this machine, unless the gate says otherwise" {
    let d = setup(new MemoryDashboardStore())
    let c = new TestClient(app(d))
    c.remote = "203.0.113.9:4000"
    c.getJson("/queue-dashboard/api/stats").assertForbidden()
    d.gate(fn(req: Request) -> bool { return req.header("X-Admin") == "yes" })
    c.getJson("/queue-dashboard/api/stats").assertForbidden()
    c.withHeader("X-Admin", "yes").getJson("/queue-dashboard/api/stats").assertOk()
}
