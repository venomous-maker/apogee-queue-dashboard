// metrics.grav — what the queue dashboard knows, and the shapes it is kept in:
// job records, jobs per minute, totals per job class and per queue (run and
// wait times), workers, queues, batches, and monitored tags. Each job event
// becomes one DashboardEvent, which a store applies in one step (one lock, one
// Redis round trip, one database transaction).
import "std"

namespace apogee {

    // One thing that happened to a job, as the store applies it.
    class DashboardEvent {
        // "queued", "processing", "processed", "released", "failed"
        public kind: string
        public jobId: string
        public job: string = ""
        public connection: string = ""
        public queue: string = ""
        // Unix milliseconds it happened.
        public at: long = 0
        // When it was queued (from its payload; 0 when unknown).
        public queuedAt: long = 0
        public attempts: int = 0
        // How long it ran (processed).
        public runMs: long = 0
        // How long it waited before starting (processing; -1 when unknown).
        public waitMs: long = -1
        public error: string = ""
        public tags: Array<string> = new Array<string>()
        public payload: string = ""
        public batchId: string = ""
        // Kept out of the recent jobs (still counted): a silenced job class.
        public silenced: bool = false
        constructor(kind: string, jobId: string) { self.kind = kind; self.jobId = jobId; }
        fn queueKey() -> string { return self.connection + "|" + self.queue; }
    }

    // One job as the dashboard saw it.
    class JobRecord {
        public id: string
        public job: string = ""
        public connection: string = ""
        public queue: string = ""
        // "queued", "processing", "processed", "released", "failed"
        public status: string = "queued"
        public attempts: int = 0
        // Unix milliseconds (0: not yet).
        public queuedAt: long = 0
        public startedAt: long = 0
        public finishedAt: long = 0
        public ms: long = 0
        public waitMs: long = -1
        public error: string = ""
        public tags: Array<string> = new Array<string>()
        public payload: string = ""
        public batchId: string = ""
        constructor(id: string) { self.id = id; }

        private static fn rank(status: string) -> int {
            switch (status) {
                case "queued": return 0
                case "processing", "released": return 1
                default: return 2
            }
        }
        // Folds `e` in (events from several processes may arrive out of order: a
        // record never goes back from a later state to "queued").
        fn apply(e: DashboardEvent) {
            if (e.job != "") { self.job = e.job; }
            if (e.connection != "") { self.connection = e.connection; }
            if (e.queue != "") { self.queue = e.queue; }
            if (e.payload != "") { self.payload = e.payload; }
            if (e.batchId != "") { self.batchId = e.batchId; }
            if (e.tags.size() > 0) { self.tags = e.tags; }
            if (e.queuedAt > 0 && self.queuedAt == 0) { self.queuedAt = e.queuedAt; }
            switch (e.kind) {
                case "queued": {
                    if (self.queuedAt == 0) { self.queuedAt = e.at; }
                    if (JobRecord.rank(self.status) == 0) { self.status = "queued"; }
                }
                case "processing": {
                    if (e.attempts >= self.attempts) {
                        self.status = "processing";
                        self.attempts = e.attempts;
                        self.startedAt = e.at;
                        if (e.waitMs >= 0) { self.waitMs = e.waitMs; }
                    }
                }
                case "released": { if (self.status != "processed" && self.status != "failed") { self.status = "released"; } }
                case "processed": { self.status = "processed"; self.finishedAt = e.at; self.ms = e.runMs; }
                case "failed": { self.status = "failed"; self.finishedAt = e.at; self.error = e.error; }
                default: {}
            }
        }

        fn toJson(withPayload: bool = true) -> JsonValue {
            let o = Json.object();
            o.set("id", self.id);
            o.set("job", self.job);
            o.set("connection", self.connection);
            o.set("queue", self.queue);
            o.set("status", self.status);
            o.set("attempts", self.attempts as long);
            o.set("queuedAt", self.queuedAt);
            o.set("startedAt", self.startedAt);
            o.set("finishedAt", self.finishedAt);
            o.set("ms", self.ms);
            o.set("waitMs", self.waitMs);
            o.set("error", self.error);
            let t = Json.array();
            for (x in self.tags) { t.push(x); }
            o.set("tags", t);
            o.set("batchId", self.batchId);
            if (withPayload) { o.set("payload", self.payload); }
            return o;
        }
        static fn fromJson(j: JsonValue) -> JobRecord {
            let r = new JobRecord(j.getString("id", ""));
            r.job = j.getString("job", "");
            r.connection = j.getString("connection", "");
            r.queue = j.getString("queue", "");
            r.status = j.getString("status", "queued");
            r.attempts = j.getInt("attempts", 0);
            r.queuedAt = j.getLong("queuedAt", 0);
            r.startedAt = j.getLong("startedAt", 0);
            r.finishedAt = j.getLong("finishedAt", 0);
            r.ms = j.getLong("ms", 0);
            r.waitMs = j.getLong("waitMs", -1);
            r.error = j.getString("error", "");
            if (j.has("tags") && j.get("tags").isArray()) { for (t in j.get("tags").asArray()) { r.tags.push(t.asString()); } }
            r.payload = j.getString("payload", "");
            r.batchId = j.getString("batchId", "");
            return r;
        }
        fn hasTag(tag: string) -> bool { return self.tags.contains(tag); }
    }

    // Jobs finished in one minute.
    class MinuteStat {
        public minute: long      // unix seconds / 60
        public processed: long = 0
        public failed: long = 0
        constructor(minute: long) { self.minute = minute; }
    }

    // A job class's totals.
    class JobMetric {
        public job: string
        public processed: long = 0
        public failed: long = 0
        public totalMs: long = 0
        public maxMs: long = 0
        constructor(job: string) { self.job = job; }
        fn averageMs() -> long { return self.processed == 0 ? 0 : self.totalMs / self.processed; }
    }

    // A queue's totals ("connection|queue").
    class QueueMetric {
        public queue: string
        public processed: long = 0
        public failed: long = 0
        public totalRunMs: long = 0
        public totalWaitMs: long = 0
        public waits: long = 0
        public maxWaitMs: long = 0
        constructor(queue: string) { self.queue = queue; }
        fn averageRunMs() -> long { return self.processed == 0 ? 0 : self.totalRunMs / self.processed; }
        fn averageWaitMs() -> long { return self.waits == 0 ? 0 : self.totalWaitMs / self.waits; }
    }

    class WorkerInfo {
        public name: string
        public connection: string = ""
        public queues: string = ""
        public startedAt: long = 0      // unix ms
        public stoppedAt: long = 0      // 0: running
        constructor(name: string) { self.name = name; }
        fn running() -> bool { return self.stoppedAt == 0; }
        fn toJson() -> string {
            let o = Json.object();
            o.set("connection", self.connection);
            o.set("queues", self.queues);
            o.set("startedAt", self.startedAt);
            o.set("stoppedAt", self.stoppedAt);
            return o.toJson();
        }
        static fn fromJson(name: string, text: string) -> WorkerInfo {
            let o = Json.parse(text);
            let w = new WorkerInfo(name);
            w.connection = o.getString("connection", "");
            w.queues = o.getString("queues", "");
            w.startedAt = o.getLong("startedAt", 0);
            w.stoppedAt = o.getLong("stoppedAt", 0);
            return w;
        }
    }

    interface DashboardStore {
        // Applies one job event: the job's record (kept among the newest `keep`,
        // and for each monitored tag it has), the per-minute, per-class and
        // per-queue counts, the queue and batch seen.
        fn record(e: DashboardEvent)
        fn job(id: string) -> JobRecord
        // Newest first.
        fn recentJobs(limit: int) -> Array<JobRecord>
        // The jobs with `tag`: all kept for a monitored tag, else the recent ones that have it.
        fn jobsWithTag(tag: string, limit: int) -> Array<JobRecord>
        // From `sinceMinute` to `untilMinute`, oldest first, empty minutes filled in.
        fn minutes(sinceMinute: long, untilMinute: long) -> Array<MinuteStat>
        fn jobMetrics() -> Array<JobMetric>
        fn queueMetrics() -> Array<QueueMetric>
        fn workerStarted(w: WorkerInfo)
        fn workerStopped(name: string, at: long)
        fn workers() -> Array<WorkerInfo>
        // "connection|queue" seen, sorted.
        fn queues() -> Array<string>
        // Batch ids seen, newest first.
        fn batchIds(limit: int) -> Array<string>
        fn monitor(tag: string)
        fn unmonitor(tag: string)
        fn monitoredTags() -> Array<string>
        // Forgets everything.
        fn clear()
    }

    // In this process's memory. Thread-safe (one lock).
    class MemoryDashboardStore implements DashboardStore {
        public keep: int
        private jobs: HashMap<string, JobRecord>
        private order: Deque<string>
        private tagged: HashMap<string, Deque<string>>      // monitored tag -> job ids, newest first
        private taggedJobs: HashMap<string, JobRecord>      // records kept for a monitored tag
        private perMinute: HashMap<long, MinuteStat>
        private perJob: HashMap<string, JobMetric>
        private perQueue: HashMap<string, QueueMetric>
        private workerMap: HashMap<string, WorkerInfo>
        private batches: Deque<string>
        private lock: Mutex
        constructor(keep: int = 1000) {
            self.keep = keep;
            self.jobs = new HashMap<string, JobRecord>();
            self.order = new Deque<string>();
            self.tagged = new HashMap<string, Deque<string>>();
            self.taggedJobs = new HashMap<string, JobRecord>();
            self.perMinute = new HashMap<long, MinuteStat>();
            self.perJob = new HashMap<string, JobMetric>();
            self.perQueue = new HashMap<string, QueueMetric>();
            self.workerMap = new HashMap<string, WorkerInfo>();
            self.batches = new Deque<string>();
            self.lock = new Mutex();
        }
        fn record(e: DashboardEvent) {
            self.lock.lock();
            // the record
            let r = self.jobs.getOr(e.jobId, null);
            if (r == null) { r = self.taggedJobs.getOr(e.jobId, null); }
            if (r == null) { r = new JobRecord(e.jobId); }
            r.apply(e);
            if (!e.silenced) {
                if (!self.jobs.containsKey(e.jobId)) {
                    self.order.pushFront(e.jobId);
                    while (self.order.size() > self.keep) { self.jobs.remove(self.order.popBack()); }
                }
                self.jobs.put(e.jobId, r);
            }
            for (t in r.tags) {
                let ids = self.tagged.getOr(t, null);
                if (ids == null) { continue; }                    // not monitored
                if (!self.taggedJobs.containsKey(e.jobId)) {
                    ids.pushFront(e.jobId);
                    while (ids.size() > self.keep) { self.taggedJobs.remove(ids.popBack()); }
                }
                self.taggedJobs.put(e.jobId, r);
            }
            // counts
            let minute = e.at / 60000;
            if (e.kind == "processed" || e.kind == "failed") {
                let m = self.perMinute.getOr(minute, null);
                if (m == null) {
                    m = new MinuteStat(minute);
                    self.perMinute.put(minute, m);
                    if (self.perMinute.size() > 2880) {          // (two days of minutes at most)
                        for (k in self.perMinute.keys()) { if (k < minute - 2880) { self.perMinute.remove(k); } }
                    }
                }
                let j = self.perJob.getOr(r.job, null);
                if (j == null) { j = new JobMetric(r.job); self.perJob.put(r.job, j); }
                let q = self.queueMetric(r.connection + "|" + r.queue);
                if (e.kind == "processed") {
                    m.processed += 1;
                    j.processed += 1;
                    j.totalMs += e.runMs;
                    if (e.runMs > j.maxMs) { j.maxMs = e.runMs; }
                    q.processed += 1;
                    q.totalRunMs += e.runMs;
                } else {
                    m.failed += 1;
                    j.failed += 1;
                    q.failed += 1;
                }
            } else if (e.kind == "processing" && e.waitMs >= 0) {
                let q = self.queueMetric(r.connection + "|" + r.queue);
                q.totalWaitMs += e.waitMs;
                q.waits += 1;
                if (e.waitMs > q.maxWaitMs) { q.maxWaitMs = e.waitMs; }
            } else if (e.kind == "queued") {
                self.queueMetric(e.queueKey());
            }
            if (e.batchId != "" && !self.batches.contains(e.batchId)) {
                self.batches.pushFront(e.batchId);
                while (self.batches.size() > 200) { self.batches.popBack(); }
            }
            self.lock.unlock();
        }
        private fn queueMetric(key: string) -> QueueMetric {
            let q = self.perQueue.getOr(key, null);
            if (q == null) { q = new QueueMetric(key); self.perQueue.put(key, q); }
            return q;
        }
        fn job(id: string) -> JobRecord {
            self.lock.lock();
            let r = self.jobs.getOr(id, null);
            if (r == null) { r = self.taggedJobs.getOr(id, null); }
            self.lock.unlock();
            return r;
        }
        fn recentJobs(limit: int) -> Array<JobRecord> {
            let out = new Array<JobRecord>();
            self.lock.lock();
            for (id in self.order) {
                if (out.size() >= limit) { break; }
                let r = self.jobs.getOr(id, null);
                if (r != null) { out.push(r); }
            }
            self.lock.unlock();
            return out;
        }
        fn jobsWithTag(tag: string, limit: int) -> Array<JobRecord> {
            let out = new Array<JobRecord>();
            self.lock.lock();
            let ids = self.tagged.getOr(tag, null);
            if (ids != null) {
                for (id in ids) {
                    if (out.size() >= limit) { break; }
                    let r = self.taggedJobs.getOr(id, null);
                    if (r != null) { out.push(r); }
                }
            } else {
                for (id in self.order) {
                    if (out.size() >= limit) { break; }
                    let r = self.jobs.getOr(id, null);
                    if (r != null && r.hasTag(tag)) { out.push(r); }
                }
            }
            self.lock.unlock();
            return out;
        }
        fn minutes(sinceMinute: long, untilMinute: long) -> Array<MinuteStat> {
            let out = new Array<MinuteStat>();
            self.lock.lock();
            let m = sinceMinute;
            while (m <= untilMinute) {
                let s = self.perMinute.getOr(m, null);
                let copy = new MinuteStat(m);
                if (s != null) { copy.processed = s.processed; copy.failed = s.failed; }
                out.push(copy);
                m += 1;
            }
            self.lock.unlock();
            return out;
        }
        fn jobMetrics() -> Array<JobMetric> {
            self.lock.lock();
            let out = self.perJob.values();
            self.lock.unlock();
            out.sortBy(fn(a: JobMetric, b: JobMetric) => Str.compare(a.job, b.job));
            return out;
        }
        fn queueMetrics() -> Array<QueueMetric> {
            self.lock.lock();
            let out = self.perQueue.values();
            self.lock.unlock();
            out.sortBy(fn(a: QueueMetric, b: QueueMetric) => Str.compare(a.queue, b.queue));
            return out;
        }
        fn workerStarted(w: WorkerInfo) { self.lock.lock(); self.workerMap.put(w.name, w); self.lock.unlock(); }
        fn workerStopped(name: string, at: long) {
            self.lock.lock();
            let w = self.workerMap.getOr(name, null);
            if (w != null) { w.stoppedAt = at; }
            self.lock.unlock();
        }
        fn workers() -> Array<WorkerInfo> {
            self.lock.lock();
            let out = self.workerMap.values();
            self.lock.unlock();
            out.sortBy(fn(a: WorkerInfo, b: WorkerInfo) => Str.compare(a.name, b.name));
            return out;
        }
        fn queues() -> Array<string> {
            self.lock.lock();
            let out = self.perQueue.keys();
            self.lock.unlock();
            out.sortBy(fn(a, b) => Str.compare(a, b));
            return out;
        }
        fn batchIds(limit: int) -> Array<string> {
            let out = new Array<string>();
            self.lock.lock();
            for (b in self.batches) { if (out.size() < limit) { out.push(b); } }
            self.lock.unlock();
            return out;
        }
        fn monitor(tag: string) {
            self.lock.lock();
            if (!self.tagged.containsKey(tag)) { self.tagged.put(tag, new Deque<string>()); }
            self.lock.unlock();
        }
        fn unmonitor(tag: string) {
            self.lock.lock();
            let ids = self.tagged.getOr(tag, null);
            self.tagged.remove(tag);
            if (ids != null) { for (id in ids) { self.taggedJobs.remove(id); } }
            self.lock.unlock();
        }
        fn monitoredTags() -> Array<string> {
            self.lock.lock();
            let out = self.tagged.keys();
            self.lock.unlock();
            out.sortBy(fn(a, b) => Str.compare(a, b));
            return out;
        }
        fn clear() {
            self.lock.lock();
            self.jobs.clear(); self.order.clear(); self.tagged.clear(); self.taggedJobs.clear(); self.perMinute.clear();
            self.perJob.clear(); self.perQueue.clear(); self.workerMap.clear(); self.batches.clear();
            self.lock.unlock();
        }
    }
}
